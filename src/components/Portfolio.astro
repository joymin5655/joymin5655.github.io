---
// Orbital Console v3 — scene-driven one-page. Content SSOT stays in
// src/data/site.ts (truth-gated copy); this file is layout + act choreography.
// The fixed WebGL stage (src/scenes/console/) sits behind these normal-flow
// sections; scroll position drives the scene's act timeline. Fallback ladder:
// html.no-3d → static poster background, all content still readable.
import type { Locale } from '../data/site';
import '../styles/console.css';

interface Props {
  data: Locale;
}
const { data } = Astro.props;
const { nav } = data;

const ACT_NAMES = ['ORBIT ENTRY', 'OBSERVATORY', 'AIRLENS ORBIT', 'AGENT GATE', 'TRAJECTORY', 'RE-ENTRY'];
const ACT_IDS = ['top', 'board', 'work', 'agent', 'timeline', 'contact'];

const metricPanels = data.board.panels.filter((p) => !p.chips);
const stackPanel = data.board.panels.find((p) => p.chips);
const agentCard = data.work.cards[0];
const moreCards = data.work.cards.slice(1); // case-study cards beyond the flagship + Agent
const toneClass = (p: { tone?: string; eyebrow: string }) =>
  p.tone === 'ok' ? 'ok' : p.eyebrow === 'GOVERNANCE' ? 'alert' : p.eyebrow === 'EDGE RUNTIME' ? 'sig' : '';
---

<canvas id="oc-stage" aria-hidden="true"></canvas>

<header class="oc-hud-top">
  <a class="oc-brand" href={data.lang === 'ko' ? '/' : '/en/'}>YONGMIN <b>CHO</b></a>
  <span class="oc-live">{data.observedLabel}</span>
  <nav class="oc-hud-links" aria-label="sections">
    <a href="#board">{nav.board}</a>
    <a href="#work">{nav.work}</a>
    <a href="#depth">{nav.depth}</a>
    <a href="#timeline">{nav.timeline}</a>
    <a href={data.lang === 'ko' ? '/research/' : '/en/research/'}>{nav.research}</a>
    <a href="#contact">{nav.contact}</a>
  </nav>
  <a class="oc-chip" style="margin-left:12px" href={data.altHref} aria-label="language">{data.altLabel}</a>
</header>

<nav class="oc-actnav" id="oc-actnav" aria-label="acts">
  {ACT_IDS.map((id, i) => (
    <a href={`#${id}`} data-act={i}>
      <span>{String(i + 1).padStart(2, '0')} {ACT_NAMES[i]}</span><i></i>
    </a>
  ))}
</nav>
<div class="oc-progress" aria-hidden="true"><i id="oc-progressbar"></i></div>

<main class="oc-main">
  <!-- ACT 1 · HERO -->
  <section class="oc-act oc-act--hero" id="top" data-act="0">
    <div class="oc-col">
      <div class="oc-eyebrow oc-reveal">{data.hero.role}</div>
      <h1 class="oc-h1 oc-reveal">{data.hero.headline.before}<em>{data.hero.headline.em}</em>{data.hero.headline.after}</h1>
      <p class="oc-sub oc-reveal">{data.hero.sub}</p>
      <div class="oc-chips oc-reveal">
        <a class="oc-chip" href={data.hero.live.url} target="_blank" rel="noopener"><b>{data.hero.live.label}</b></a>
        {data.hero.metrics.map((m) => (
          <span class="oc-chip"><b>{m.value}</b> {m.label}</span>
        ))}
      </div>
      <p class="oc-foot oc-reveal">{data.hero.footnote}</p>
      <div class="oc-ctas oc-reveal">
        {data.hero.ctas.map((c) => (
          <a class={`oc-btn ${c.primary ? 'oc-btn--pri' : 'oc-btn--sec'}`} href={c.url}>{c.label}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ACT 2 · OBSERVATORY -->
  <section class="oc-act" id="board" data-act="1">
    <div class="oc-col">
      <h2 class="oc-eyebrow oc-reveal">ACT 02 · {data.board.heading}</h2>
      <div class="oc-metrics oc-reveal">
        {metricPanels.map((p) => (
          <div class="oc-metric oc-reveal">
            <div class={`v ${toneClass(p)}`}>
              <span data-count={/^[\d,]+$/.test(p.value) ? p.value : undefined}>{p.value}</span>
              {p.unit && <span class="u">{p.unit}</span>}
            </div>
            <div class="l">{p.label}</div>
            {p.evidence && (
              <div class="l"><a href={p.evidence.url} target="_blank" rel="noopener">{p.evidence.label} ↗</a></div>
            )}
          </div>
        ))}
        {stackPanel?.chips && (
          <div class="oc-metric">
            <div class="l" style="margin-top:0">{stackPanel.eyebrow}</div>
            <div class="oc-tags" style="margin-top:10px">
              {stackPanel.chips.map((c) => <span class="oc-tag">{c}</span>)}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ACT 3 · AIRLENS (flagship + DS depth) -->
  <section class="oc-act" id="work" data-act="2">
    <div class="oc-col">
      <div class="oc-eyebrow oc-reveal">ACT 03 · {data.work.heading}</div>
      <h2 class="oc-h2 oc-reveal">{data.work.flagship.name} — {data.work.flagship.tag}</h2>
      <div class="oc-panel oc-reveal">
        <p class="oc-body">{data.work.flagship.blurb}</p>
        <div class="oc-tags">
          {data.work.flagship.links.map((l) => (
            <a class="oc-tag oc-tag--lime" href={l.url} target="_blank" rel="noopener">{l.label}</a>
          ))}
          <a class="oc-tag" href={data.work.flagship.caseHref}>{data.work.flagship.caseLabel}</a>
        </div>
      </div>
      <div class="oc-subsys oc-reveal" id="depth">
        {data.work.flagship.subsystems.map((s) => (
          <a class="oc-subrow" href={s.href}>
            <span class="val">{s.value}</span>
            <span class="ttl">{s.title}</span>
            <span class="dsc">{s.desc}</span>
          </a>
        ))}
      </div>
      <div class="oc-panel oc-reveal" style="margin-top:18px">
        <p class="oc-body"><b>{data.depth.heading}</b> — {data.depth.lead}</p>
        <div class="oc-tags">
          {data.depth.rows.map((r) => (
            <a class="oc-tag" href={r.evidence.url} title={r.where}>{r.method}</a>
          ))}
        </div>
        <p class="oc-foot">{data.depth.note}</p>
      </div>
      {/* MORE SYSTEMS — locale-invariant HUD label; card copy comes from site.ts */}
      <div class="oc-eyebrow oc-reveal" style="margin-top:34px">MORE SYSTEMS</div>
      <div class="oc-more">
        {moreCards.map((c) => (
          <a class="oc-morecard oc-tilt oc-reveal" href={c.caseHref ?? c.links[0]?.url ?? '#'}>
            <span class="oc-morecard-tag">{c.tag}</span>
            <h3>{c.name}<span class="oc-morecard-arrow" aria-hidden="true">→</span></h3>
            <p>{c.blurb}</p>
            <div class="oc-tags">{c.chips.map((ch) => <span class="oc-tag">{ch}</span>)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ACT 4 · AGENT GATE -->
  <section class="oc-act" id="agent" data-act="3">
    <div class="oc-col oc-col--wide">
      {/* "GOVERNANCE" + gate rows below are locale-invariant HUD dressing (like ACT_NAMES), not site.ts copy */}
      <div class="oc-eyebrow oc-reveal">ACT 04 · GOVERNANCE</div>
      <h2 class="oc-h2 oc-reveal">{agentCard.name} — {agentCard.tag}</h2>
      <div class="oc-panel oc-reveal">
        <p class="oc-body">{agentCard.blurb}</p>
        <div class="oc-gaterows" aria-hidden="true">
          <div class="oc-gaterow"><i></i>plan-approved edit<span class="r">PASS</span></div>
          <div class="oc-gaterow"><i></i>read-only reviewer<span class="r">PASS</span></div>
          <div class="oc-gaterow deny"><i></i>git reset --hard<span class="r">DENIED</span></div>
          <div class="oc-gaterow deny"><i></i>secret file read<span class="r">DENIED</span></div>
        </div>
        <div class="oc-tags">
          {agentCard.chips.map((c) => <span class="oc-tag">{c}</span>)}
          {agentCard.links.map((l) => (
            <a class="oc-tag oc-tag--lime" href={l.url} target="_blank" rel="noopener">{l.label}</a>
          ))}
          {agentCard.caseHref && (
            <a class="oc-tag oc-tag--lime" href={agentCard.caseHref}>CASE →</a>
          )}
        </div>
      </div>
      <div class="oc-panel oc-reveal">
        <div class="oc-eyebrow">{data.aiNote.title}</div>
        <p class="oc-body">{data.aiNote.body}</p>
        <div class="oc-tags">
          {data.aiNote.rows.map((r) => <span class="oc-tag">{r}</span>)}
        </div>
      </div>

      <div class="oc-eyebrow oc-reveal oc-aip-head">{data.aiPractice.heading}</div>
      <p class="oc-body oc-reveal oc-xp-lead">{data.aiPractice.lead}</p>
      <ol class="oc-aip" role="list">
        {data.aiPractice.items.map((it) => (
          <li class="oc-aip-item oc-reveal">
            <span class="oc-aip-date">{it.date}</span>
            <div>
              <h3 class="oc-aip-title">{it.title}</h3>
              <p class="oc-aip-body">{it.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="oc-panel oc-reveal oc-aip-theses">
        <div class="oc-eyebrow">{data.aiPractice.thesesLabel}</div>
        <ul class="oc-aip-thesis-list" role="list">
          {data.aiPractice.theses.map((t) => <li>“{t}”</li>)}
        </ul>
        <p class="oc-foot">{data.aiPractice.note}</p>
      </div>
    </div>
  </section>

  <!-- ACT 5 · TRAJECTORY — experience ledger + field notes + recognition -->
  <section class="oc-act oc-act--xp" id="timeline" data-act="4">
    <div class="oc-col oc-col--wide">
      <h2 class="oc-eyebrow oc-reveal">ACT 05 · {data.timeline.heading}</h2>
      <p class="oc-body oc-reveal oc-xp-lead">{data.timeline.lead}</p>

      <ol class="oc-xp" role="list">
        {data.timeline.items.map((it) => (
          <li class={`oc-xp-item oc-reveal is-${it.kind}`}>
            <div class="oc-xp-rail" aria-hidden="true"><i></i></div>
            <div class="oc-xp-meta">
              <span class="oc-xp-period">{it.period}</span>
              <span class="oc-xp-kind">{it.kindLabel}</span>
            </div>
            <div class="oc-xp-body oc-tilt">
              <h3 class="oc-xp-title">
                {it.title}
                {it.link && (
                  <a class="oc-xp-link" href={it.link.url} target="_blank" rel="noopener">{it.link.label}</a>
                )}
              </h3>
              <div class="oc-xp-role">{it.role}</div>
              <p class="oc-xp-text">{it.body}</p>
              {it.bullets && (
                <ul class="oc-xp-bullets">
                  {it.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
              {it.tags && (
                <div class="oc-tags oc-xp-tags">
                  {it.tags.map((t) => <span class="oc-tag">{t}</span>)}
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>

      <div class="oc-edu-block oc-reveal">
        <p class="oc-edu" set:html={data.timeline.edu} />
        <p class="oc-edu oc-edu--thesis">{data.timeline.thesis}</p>
      </div>

      <div class="oc-eyebrow oc-reveal oc-xp-sub">{data.fieldNotes.heading}</div>
      <p class="oc-body oc-reveal oc-xp-lead">{data.fieldNotes.lead}</p>
      <div class="oc-notes">
        {data.fieldNotes.items.map((n, i) => (
          <article class={`oc-note oc-tilt oc-reveal ${n.tone ?? ''}`}>
            <span class="oc-note-idx">{String(i + 1).padStart(2, '0')}</span>
            <div class="oc-note-metric">{n.metric}</div>
            <div class="oc-note-mlabel">{n.metricLabel}</div>
            <h3 class="oc-note-title">{n.title}</h3>
            <p class="oc-note-body">{n.body}</p>
          </article>
        ))}
      </div>

      <div class="oc-recog oc-reveal">
        <div class="oc-eyebrow">{data.recognition.heading}</div>
        <ul class="oc-recog-list" role="list">
          {data.recognition.awards.map((a) => (
            <li>
              <span class="y">{a.year ?? ''}</span>
              <span class="t">{a.title}</span>
              <span class="o">{a.org}</span>
            </li>
          ))}
        </ul>
        <div class="oc-recog-certs">
          <span class="oc-recog-certs-label">{data.recognition.certsLabel}</span>
          {data.recognition.certs.map((c) => <span class="oc-tag">{c}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ACT 6 · RE-ENTRY -->
  <section class="oc-act oc-act--center" id="contact" data-act="5">
    <div class="oc-col">
      <div class="oc-eyebrow oc-reveal" style="letter-spacing:0.32em">ACT 06 · {data.contact.heading}</div>
      <h2 class="oc-h1 oc-reveal" style="font-size:clamp(2rem,4.4vw,3.4rem)">{data.contact.lead}</h2>
      <div class="oc-ctas oc-reveal" style="justify-content:center">
        {data.contact.items.map((it, i) => (
          <a class={`oc-btn ${i === 0 ? 'oc-btn--pri' : 'oc-btn--sec'}`} href={it.url} target={it.url.startsWith('mailto') ? undefined : '_blank'} rel="noopener">{it.label}</a>
        ))}
      </div>
    </div>
  </section>
</main>

<footer class="oc-footer">
  <span>© 2026 Yongmin Cho (조용민)</span>
  <span>Orbital Console · Astro + Three.js · GitHub Pages</span>
</footer>

<script>
  import { bootConsole } from '../scenes/console/boot';

  const canvas = document.getElementById('oc-stage') as HTMLCanvasElement | null;
  const acts = [...document.querySelectorAll<HTMLElement>('.oc-act')];
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('#oc-actnav a')];
  const progressBar = document.getElementById('oc-progressbar');

  /* ── scroll→act timeline (HUD wired before the lazy 3D chunk resolves) ── */
  if (canvas) {
    let mids: number[] = [];
    const measure = () => {
      mids = acts.map((s) => s.offsetTop + s.offsetHeight / 2);
    };
    measure();
    addEventListener('resize', measure);
    // layout shifts after boot (font swap, late assets) desync the midpoints
    if (document.readyState === 'complete') measure();
    else addEventListener('load', measure);
    document.fonts?.ready.then(measure);

    const actFNow = () => {
      const mid = scrollY + innerHeight / 2;
      if (mid <= mids[0]) return 0;
      if (mid >= mids[mids.length - 1]) return mids.length - 1;
      let i = 0;
      while (i < mids.length - 2 && mid >= mids[i + 1]) i++;
      return i + (mid - mids[i]) / Math.max(1, mids[i + 1] - mids[i]);
    };

    const doc = document.documentElement;
    const paintHud = (f: number) => {
      const p = Math.min(1, Math.max(0, scrollY / (doc.scrollHeight - innerHeight)));
      if (progressBar) progressBar.style.width = (p * 100).toFixed(2) + '%';
      const ci = Math.round(f);
      navLinks.forEach((a, i) => a.classList.toggle('on', i === ci));
    };

    // progress bar + act dots respond immediately (also the no-3d path)
    const cheap = () => paintHud(actFNow());
    addEventListener('scroll', cheap, { passive: true });
    cheap();

    bootConsole(canvas).then((handle) => {
      if (!handle) return; // no-3d keeps the cheap scroll listener
      removeEventListener('scroll', cheap);
      let smoothF = actFNow(); // start from the current position, not act 0
      const sync = () => {
        smoothF += (actFNow() - smoothF) * 0.09;
        handle.setActF(smoothF);
        paintHud(smoothF);
        requestAnimationFrame(sync);
      };
      requestAnimationFrame(sync);
    });
  }

  /* ── content reveals (IO, html.js gate from Base.astro) ── */
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll('.oc-reveal');
  if (!reduce && 'IntersectionObserver' in window && els.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries)
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    els.forEach((el) => io.observe(el));
    setTimeout(() => els.forEach((el) => el.classList.add('is-visible')), 3000);
  } else {
    els.forEach((el) => el.classList.add('is-visible'));
  }

  /* ── pointer tilt (hover-capable, motion-allowed devices only) ── */
  const canTilt = !reduce && matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (canTilt) {
    const MAX = 3.2; // degrees — subtle, Apple-card-like
    document.querySelectorAll<HTMLElement>('.oc-tilt').forEach((el) => {
      let raf = 0;
      const onMove = (e: PointerEvent) => {
        const r = el.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          el.style.setProperty('--ry', `${((px - 0.5) * 2 * MAX).toFixed(2)}deg`);
          el.style.setProperty('--rx', `${((0.5 - py) * 2 * MAX).toFixed(2)}deg`);
          el.style.setProperty('--gx', `${(px * 100).toFixed(1)}%`);
          el.style.setProperty('--gy', `${(py * 100).toFixed(1)}%`);
        });
      };
      el.addEventListener('pointerenter', () => el.classList.add('is-tilting'));
      el.addEventListener('pointermove', onMove);
      el.addEventListener('pointerleave', () => {
        el.classList.remove('is-tilting');
        el.style.setProperty('--rx', '0deg');
        el.style.setProperty('--ry', '0deg');
      });
    });
  }

  /* ── counter roll-up ── */
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!reduce && counters.length) {
    const fmt = (n: number) => n.toLocaleString('en-US');
    const run = (el: HTMLElement) => {
      const end = parseInt((el.dataset.count || '').replace(/,/g, ''), 10);
      if (!Number.isFinite(end)) return;
      const t0 = performance.now();
      const dur = 900;
      const tick = (t: number) => {
        const p = Math.min((t - t0) / dur, 1);
        el.textContent = fmt(Math.round(end * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const cio = new IntersectionObserver(
      (entries) => {
        for (const e of entries)
          if (e.isIntersecting) {
            run(e.target as HTMLElement);
            cio.unobserve(e.target);
          }
      },
      { threshold: 0.4 }
    );
    counters.forEach((el) => cio.observe(el));
  }
</script>
